{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infonavidareal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infonavidareal",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SITE_URL": "http://localhost:8787",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "REVISION_LIMIT": "20",
  },
  "env": {
    "production": {
      "vars": {
        "SITE_URL": "https://substituir.workers.dev",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "REVISION_LIMIT": "20",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "infonavidareal",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
